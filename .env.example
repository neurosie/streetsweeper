# ==============================================================================
# Environment Variables Template
# ==============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to git (it's in .gitignore)
# ==============================================================================

# Your email address (required by the application)
OWNER_EMAIL=your-email@example.com

# Mapbox API token (get one at: https://account.mapbox.com/access-tokens/)
# NOTE: NEXT_PUBLIC_* variables are embedded into the browser JavaScript at BUILD time
# This is the LOCAL DEVELOPMENT token only. The production token is passed as a
# build arg at deploy time -- see README "Deployment". Never deploy this one.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Local dev: development | Production: production
NODE_ENV=development

# AWS S3 -- caches geographic data (see src/server/s3.ts)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2
AWS_BUCKET_NAME=your-bucket
