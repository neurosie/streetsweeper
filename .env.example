# ==============================================================================
# Environment Variables Template
# ==============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to git (it's in .gitignore)
#
# This file works for both local development and production deployment.
# ==============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Your email address (required by the application)
OWNER_EMAIL=your-email@example.com

# Mapbox API token (get one at: https://account.mapbox.com/access-tokens/)
# NOTE: NEXT_PUBLIC_* variables are embedded into the browser JavaScript at BUILD time
# If you change this after building, you MUST rebuild: docker compose up -d --build app
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Local dev: development
# Production: production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Nginx Configuration (Docker only)
# -----------------------------------------------------------------------------
# Local dev: nginx.local.conf (no SSL)
# Production: nginx.conf (with SSL)
NGINX_CONFIG_FILE=nginx.local.conf

# -----------------------------------------------------------------------------
# Optional: AWS S3 Configuration
# -----------------------------------------------------------------------------
# Uncomment if you're using S3 for file storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket
